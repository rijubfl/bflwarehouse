<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    tools:context=".ui.palletstatus.PalletStatusFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">



        <ListView
            android:id="@+id/lv_building_del_pallet_details"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/et_custom_total"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.842"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView3"
            app:layout_constraintVertical_bias="0.0" />



        <TextView
            android:id="@+id/TextView3"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="6dp"
            android:text="Pallet No."
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_pallet_status_last_palletno" />

        <TextView
            android:id="@+id/TextView4"
            android:layout_width="130dp"
            android:layout_height="30dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="6dp"
            android:text="Status."
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/TextView3"
            app:layout_constraintTop_toTopOf="@+id/TextView3" />

        <TextView
            android:id="@+id/TextView5"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="6dp"
            android:text="Date Time."
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TextView4"
            app:layout_constraintTop_toTopOf="@+id/TextView3" />

        <TextView
            android:id="@+id/TextView1"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:layout_marginRight="5dp"
            android:textColor="@color/coloBlack"
            android:hint=""
            android:layout_marginEnd="5dp"
            android:padding="10dp"
            android:text="Warehouse"
            android:textSize="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Spinner
            android:id="@+id/sp_rack_in_out_warehouse"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:textColor="@color/coloBlack"
            android:layout_marginEnd="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:text="[Select Warehouse]"
            android:padding="10dp"
            android:textSize="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TextView1"
            app:layout_constraintTop_toTopOf="parent" />


        <EditText
            android:id="@+id/et_pallet_status_palletno"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:hint="Scan Pallet / Box / Tote"
            android:padding="10dp"
            android:textColor="@color/coloBlack"

            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/bt_pallet_status_scan"
            app:layout_constraintStart_toStartOf="@id/TextView1"
            app:layout_constraintTop_toBottomOf="@id/TextView1"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <Button
            android:id="@+id/bt_pallet_status_scan"
            android:layout_width="70dp"
            android:layout_height="45dp"
            android:background="@drawable/btn_custom1"
            android:text="SCAN"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_pallet_status_palletno"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/tv_pallet_status_message"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Message"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_pallet_status_palletno" />

        <TextView
            android:id="@+id/tv_pallet_status_last_scan"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Last Scan"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_pallet_status_message" />

        <TextView
            android:id="@+id/tv_pallet_status_result"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="3dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Result"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloRed"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/textView2"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_pallet_status_last_scan" />

        <TextView
            android:id="@+id/tv_pallet_status_last_palletno"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="3dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Pallet No."
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/textView2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_pallet_status_last_pallet_boxno" />

        <TextView
            android:id="@+id/tv_pallet_status_last_building_category"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Building Categories"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_pallet_status_last_building_golden"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_pallet_status_result" />

        <TextView
            android:id="@+id/tv_pallet_status_last_building_golden"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Golden Label"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_pallet_status_result" />

        <TextView
            android:id="@+id/tv_pallet_status_last_pallet_boxno"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="3dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Box No."
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/textView2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_pallet_status_last_building_category" />

        <TextView
            android:id="@+id/tv_pallet_status_last_pallet_checking_type"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="3dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Checking Type"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloRed"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView2"
            app:layout_constraintTop_toTopOf="@+id/tv_pallet_status_result" />

        <TextView
            android:id="@+id/tv_pallet_status_last_pallet_toteid"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="3dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Tote Id"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView2"
            app:layout_constraintTop_toTopOf="@+id/tv_pallet_status_last_pallet_boxno" />

        <TextView
            android:id="@+id/tv_pallet_status_last_pallet_pallettype"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="3dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Pallet Type"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView2"
            app:layout_constraintTop_toTopOf="@+id/tv_pallet_status_last_palletno" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:text=""
            android:textColor="@color/colorAccent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="SpeakableTextPresentCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>