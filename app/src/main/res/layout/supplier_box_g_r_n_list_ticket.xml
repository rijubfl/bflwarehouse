<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dr_supp_grn_list_main"
    android:orientation="horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0"
        android:orientation="vertical">

    <TextView
        android:id="@+id/tv_ticket_supplier_box_grn_container_id"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/et_custom_total"
        android:hint=""
        android:padding="5dp"
        android:text="Carton ID"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_ticket_supplier_box_grn_delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_ticket_supplier_box_grn_po"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:hint=""
        android:padding="5dp"
        android:text="PO"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_ticket_supplier_box_grn_carton_qty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_ticket_supplier_box_grn_container_id" />

    <TextView
        android:id="@+id/tv_ticket_supplier_box_grn_carton_qty"
        android:layout_width="90dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:hint=""
        android:padding="5dp"
        android:text="Qty"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_ticket_supplier_box_grn_audit"
        app:layout_constraintTop_toTopOf="@+id/tv_ticket_supplier_box_grn_po" />

    <TextView
        android:id="@+id/tv_ticket_supplier_box_grn_audit"
        android:layout_width="65dp"
        android:layout_height="30dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="5dp"
        android:text="Audit"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_ticket_supplier_box_grn_delete"
        app:layout_constraintTop_toTopOf="@+id/tv_ticket_supplier_box_grn_po" />

    <Button
        android:id="@+id/bt_ticket_supplier_box_grn_delete"
        android:layout_width="75dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginRight="2dp"
        android:layout_weight="1"
        android:background="@color/colorBtn"
        android:text="Delete"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ticket_supplier_box_grn_po"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
