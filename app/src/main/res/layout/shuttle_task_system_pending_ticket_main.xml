<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">


    <TextView
        android:id="@+id/tv_shuttle_task_system_pending_ticket_main_toteid"
        android:layout_width="95dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_shuttle_task_system_pending_ticket_main_status"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_shuttle_task_system_pending_ticket_main_delete"
        app:layout_constraintStart_toEndOf="@+id/tv_shuttle_task_system_pending_ticket_main_toteid"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/bt_shuttle_task_system_pending_ticket_main_delete"
        android:layout_width="50dp"
        android:layout_height="30dp"
        android:layout_weight="1"
        android:background="@color/colorBtn"
        android:text="Del"
        app:layout_constraintBottom_toBottomOf="@+id/tv_shuttle_task_system_pending_ticket_main_toteid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_shuttle_task_system_pending_ticket_main_toteid" />



</androidx.constraintlayout.widget.ConstraintLayout>