<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/backColor">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">
        <Button
            android:id="@+id/bt_scan_newbarcode"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/btn_custom1"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:text="Scan Generated Barcode"
            android:textAllCaps="false"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/TextView4"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom_total"
            android:layout_marginTop="10dp"
            android:textStyle="bold"
            android:padding="10dp"
            android:textAlignment="center"
            android:text="UPC"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_scan_newbarcode" />




        <TextView
            android:id="@+id/TextView5"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginLeft="0dp"
            android:background="@drawable/et_custom_total"
            android:padding="10dp"
            android:text="New UPC Barcode"
            android:textColor="@color/coloBlack"
            android:textAlignment="center"
            android:textSize="14sp"

            app:layout_constraintStart_toEndOf="@+id/TextView4"
            app:layout_constraintTop_toTopOf="@+id/TextView4"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/TextView6"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginLeft="0dp"
            android:background="@drawable/et_custom_total"
            android:padding="10dp"
            android:text="Status"
            android:textColor="@color/coloBlack"
            android:textAlignment="center"
            android:textSize="14sp"

            app:layout_constraintStart_toEndOf="@+id/TextView5"
            app:layout_constraintTop_toTopOf="@+id/TextView4"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/TextView7"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="0dp"
            android:background="@drawable/et_custom_total"
            android:padding="10dp"
            android:text="Delete"
            android:textColor="@color/coloBlack"
            android:textAlignment="center"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TextView6"
            app:layout_constraintTop_toTopOf="@+id/TextView4"
            android:textStyle="bold"
            />



        <ListView
            android:id="@+id/lv_building_details"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="3dp"
            android:textAlignment="center"
            android:background="@drawable/et_custom_total"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/et_remarks"
            app:layout_constraintTop_toBottomOf="@+id/TextView5" />


        <TextView
            android:id="@+id/tv_count_good"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_margin="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:padding="8dp"
            android:text="0"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"

            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_remarks" />
        <EditText
            android:id="@+id/tv_good_toteid"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:inputType="text"
            android:layout_marginStart="20dp"
            android:background="@drawable/et_custom"
            android:hint="Scan Good Tote"
            android:padding="2dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="15sp"
            android:textStyle="bold"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_count_good" />
        <TextView
            android:id="@+id/tv_remarks"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:padding="8dp"
            android:text="Remarks"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lv_building_details" />

        <EditText
            android:id="@+id/et_remarks"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:background="@drawable/et_custom"
            android:hint="Remarks"
            android:inputType="text"
            android:padding="2dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/tv_remarks"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lv_building_details" />

        <Button
            android:id="@+id/bt_good_toteid"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:textStyle="bold"
            android:padding="2dp"
            android:layout_margin="8dp"
            android:background="@drawable/btn_custom1"
            android:textAlignment="center"
            android:text="Check In"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_good"
            app:layout_constraintTop_toBottomOf="@+id/tv_good_toteid"
            />

        <TextView
            android:id="@+id/tv_good"
            android:layout_width="120dp"
            android:layout_height="30dp"
            android:textStyle="bold"
            android:padding="2dp"
            android:layout_margin="8dp"
            android:textAlignment="center"
            android:text="Good"
            android:textColor="@color/coloBlack"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bt_clear_box"
            app:layout_constraintTop_toBottomOf="@+id/bt_good_toteid" />

        <TextView
            android:id="@+id/tv_count_asis"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:padding="10dp"
            android:text="0"
            android:textColor="@color/coloBlack"
            android:gravity="center"
            android:textSize="14sp"
            android:layout_margin="8dp"
            app:layout_constraintStart_toEndOf="@+id/tv_count_good"
            app:layout_constraintTop_toBottomOf="@+id/et_remarks"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/tv_count_writeoff"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="0dp"
            android:background="@drawable/et_custom"
            android:padding="10dp"
            android:text="0"
            android:textColor="@color/coloBlack"
            android:layout_margin="8dp"
            android:gravity="center"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_count_asis"
            app:layout_constraintTop_toBottomOf="@+id/et_remarks"
            android:textStyle="bold"
            />




        <EditText
            android:id="@+id/tv_asis_toteid"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginLeft="0dp"
            android:padding="2dp"
            android:text=""
            android:inputType="text"
            android:hint="Scan As Is Tote"
            android:background="@drawable/et_custom"
            android:textColor="@color/coloBlack"
            android:textAlignment="center"
            android:textSize="15sp"
            android:layout_margin="8dp"

            app:layout_constraintStart_toEndOf="@+id/tv_good"
            app:layout_constraintTop_toBottomOf="@+id/tv_count_good"
            android:textStyle="bold"
            />

        <Button
            android:id="@+id/bt_asis_toteid"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:textStyle="bold"
            android:padding="2dp"
            android:layout_margin="8dp"
            android:background="@drawable/btn_custom1"
            android:textAlignment="center"
            android:text="Check In"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/bt_good_toteid"
            app:layout_constraintBottom_toTopOf="@+id/tv_asis"
            app:layout_constraintTop_toBottomOf="@+id/tv_asis_toteid"
            />

        <TextView
            android:id="@+id/tv_asis"
            android:layout_width="120dp"
            android:layout_height="30dp"
            android:layout_margin="8dp"
            android:padding="2dp"
            android:text="As Is"
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/bt_clear_box"
            app:layout_constraintStart_toEndOf="@+id/tv_good"
            app:layout_constraintTop_toBottomOf="@+id/bt_asis_toteid" />

        <EditText
            android:id="@+id/tv_writeoff_toteid"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="0dp"
            android:padding="2dp"
            android:text=""
            android:inputType="text"
            android:background="@drawable/et_custom"
            android:textColor="@color/coloBlack"
            android:layout_margin="8dp"
            android:hint="Scan Write off Toteid"
            android:textAlignment="center"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_asis"
            app:layout_constraintTop_toBottomOf="@+id/tv_count_good"
            android:textStyle="bold"
            />
        <Button
            android:id="@+id/bt_writeoff_toteid"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:textStyle="bold"
            android:padding="2dp"
            android:layout_margin="8dp"
            android:background="@drawable/btn_custom1"
            android:textAlignment="center"
            android:text="Check In"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/bt_asis_toteid"
            app:layout_constraintBottom_toTopOf="@+id/tv_writeoff"
            app:layout_constraintTop_toBottomOf="@+id/tv_writeoff_toteid"
            />
        <TextView
            android:id="@+id/tv_writeoff"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginLeft="0dp"
            android:padding="2dp"
            android:text="Write off"
            android:textColor="@color/coloBlack"
            android:layout_margin="8dp"
            android:textAlignment="center"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_asis"
            app:layout_constraintBottom_toTopOf="@+id/bt_clear_box"
            app:layout_constraintTop_toBottomOf="@+id/bt_writeoff_toteid"
            android:textStyle="bold"
            />


        <Button
            android:id="@+id/bt_clear_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/btn_custom1"
            android:text="CLEAR"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

