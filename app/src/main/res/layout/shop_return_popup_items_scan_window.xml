<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="390dp"
    android:padding="5dp"
    android:background="@color/colorBackPopup"
    android:layout_gravity="center"
    android:layout_height="650dp">

    <TextView
        android:id="@+id/TextView8"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:hint=""
        android:padding="10dp"
        android:text="Actions."
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_shop_return_popup_itemcode"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginRight="2dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom"
        android:hint="Scan Itemcode"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/et_shop_return_popup_qty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TextView8" />

    <Spinner
        android:id="@+id/sp_shop_return_popup_action"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="8dp"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/TextView8"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    <EditText
        android:id="@+id/et_shop_return_popup_qty"
        android:layout_width="50dp"
        android:layout_height="35dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/et_custom"
        android:gravity="right"
        android:hint="Qty"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_shop_return_popup_scan"
        app:layout_constraintTop_toTopOf="@+id/et_shop_return_popup_itemcode" />

    <Button
        android:id="@+id/bt_shop_return_popup_scan"
        android:layout_width="60dp"
        android:layout_height="35dp"
        android:background="@drawable/btn_custom1"
        android:text="SCAN"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_shop_return_popup_itemcode" />


    <TextView
        android:id="@+id/tv_shop_return_popup_last_scan"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom_total"
        android:hint="Last Scan"
        android:padding="8dp"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_shop_return_popup_itemcode" />

    <TextView
        android:id="@+id/tv_shop_return_popup_division"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom_total"
        android:hint="Division"
        android:padding="8dp"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_shop_return_popup_last_scan" />

    <TextView
        android:id="@+id/tv_shop_return_popup_season"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/et_custom_total"
        android:hint="Season"
        android:padding="8dp"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_shop_return_popup_division" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="140dp"
        android:layout_height="28dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:padding="5dp"
        android:text="Itemcode"
        android:textColor="@color/coloBlack"
        android:textSize="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_shop_return_popup_season" />

    <TextView
        android:id="@+id/textView15"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:padding="5dp"
        android:text="Actions"
        android:textColor="@color/coloBlack"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/textView3"
        app:layout_constraintStart_toEndOf="@+id/textView1"
        app:layout_constraintTop_toTopOf="@+id/textView1" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="50dp"
        android:layout_height="28dp"
        android:layout_marginRight="8dp"
        android:gravity="center"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text="Qty"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/textView5"
        app:layout_constraintTop_toTopOf="@+id/textView1" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="60dp"
        android:layout_height="28dp"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text=""
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView1" />

    <ListView
        android:id="@+id/lv_shop_return_popup_scandetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/et_custom_total"
        app:layout_constraintBottom_toTopOf="@+id/bt_shop_return_popup_ok"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView1" />

    <Button
        android:id="@+id/bt_shop_return_popup_ok"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/btn_custom1"
        android:text="OK"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/textView2"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/bt_shop_return_popup_close"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/btn_custom1"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textView2" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:text="   "
        android:textColor="@color/colorAccent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="SpeakableTextPresentCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>