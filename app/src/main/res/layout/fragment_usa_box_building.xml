<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    tools:context=".ui.usaboxbuilding.UsaBoxBuildingFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="6dp">

        <RadioGroup
            android:id="@+id/rg_pallet_building_category"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <RadioButton
                android:id="@+id/rb_usa_box_usa_category"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:background="@drawable/et_custom"
                android:checked="true"
                android:text="USA"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/TextView16"
                app:layout_constraintTop_toTopOf="@+id/TextView16"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/rb_usa_box_tcm_category"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_marginLeft="5dp"
                android:background="@drawable/et_custom"
                android:text="TCM"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/rb_usa_box_usa_category"
                app:layout_constraintTop_toTopOf="@+id/TextView16"
                tools:ignore="TouchTargetSizeCheck" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_usa_box_boxprefix"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:textStyle="bold"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/rg_pallet_building_category"
            app:layout_constraintTop_toTopOf="@+id/rg_pallet_building_category" />

        <Spinner
            android:id="@+id/sp_usa_box_printer"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rg_pallet_building_category" />

        <CheckBox
            android:id="@+id/ch_usa_box_euro"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:text="Euro"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <CheckBox
            android:id="@+id/ch_usa_box_reprint"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:text="Reprint"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_usa_box_building_category" />

        <TextView
            android:id="@+id/tv_usa_box_pallettype_select"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint="Select Pallet Type"
            android:padding="10dp"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_usa_box_pallettype"
            app:layout_constraintStart_toEndOf="@+id/sp_usa_box_printer"
            app:layout_constraintTop_toTopOf="@+id/sp_usa_box_printer" />

        <TextView
            android:id="@+id/tv_usa_box_pallettype"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/sp_usa_box_printer" />

        <TextView
            android:id="@+id/tv_usa_box_pallettype_allowmix"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/tv_usa_box_boxprefix"
            app:layout_constraintTop_toTopOf="@+id/rg_pallet_building_category" />

        <TextView
            android:id="@+id/tv_usa_box_pallettype_build_sec"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/tv_usa_box_pallettype_allowmix"
            app:layout_constraintTop_toTopOf="@+id/rg_pallet_building_category" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="65dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Size"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sp_usa_box_printer" />

        <TextView
            android:id="@+id/textView15"
            android:layout_width="65dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Gender"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/sp_usa_box_size"
            app:layout_constraintTop_toTopOf="@+id/textView3" />

        <Spinner
            android:id="@+id/sp_usa_box_size"
            android:layout_width="135dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/textView3"
            app:layout_constraintTop_toTopOf="@+id/textView3"
            tools:ignore="TouchTargetSizeCheck" />

        <Spinner
            android:id="@+id/sp_usa_box_gender"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView15"
            app:layout_constraintTop_toTopOf="@+id/textView3" />

        <Spinner
            android:id="@+id/sp_usa_box_task"
            android:layout_width="135dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/textView10"
            app:layout_constraintTop_toTopOf="@+id/textView10" />

        <Spinner
            android:id="@+id/sp_usa_box_done"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView16"
            app:layout_constraintTop_toTopOf="@+id/textView10" />

        <TextView
            android:id="@+id/tv_usa_box_building_category"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:hint="Building Category"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/ch_usa_box_reprint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView10" />

        <TextView
            android:id="@+id/TextView12"
            android:layout_width="135dp"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="6dp"
            android:text="Itemcode"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_usa_box_building_category" />

        <TextView
            android:id="@+id/TextView13"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="6dp"
            android:text="Description"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView14"
            app:layout_constraintStart_toEndOf="@+id/TextView12"
            app:layout_constraintTop_toTopOf="@+id/TextView12" />

        <TextView
            android:id="@+id/TextView14"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:background="@drawable/et_custom_total"
            android:gravity="right"
            android:hint=""
            android:padding="6dp"
            android:text="Qty"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView12" />

        <ListView
            android:id="@+id/lv_usa_box_details"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom_total"
            app:layout_constraintBottom_toTopOf="@+id/et_usa_contno"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView12" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="65dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Task."
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView3" />

        <EditText
            android:id="@+id/et_usa_contno"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint="Contno(Optional)"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/TextView10"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/et_usa_box_toteid"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:inputType="text"
            android:padding="10dp"
            android:hint="Toteid"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_usa_box_last_box"
            app:layout_constraintStart_toEndOf="@+id/et_usa_contno"
            app:layout_constraintTop_toTopOf="@+id/et_usa_contno" />

        <TextView
            android:id="@+id/tv_usa_box_last_box"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_usa_contno" />

        <TextView
            android:id="@+id/textView16"
            android:layout_width="65dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Done."
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/sp_usa_box_task"
            app:layout_constraintTop_toTopOf="@+id/textView10" />

        <TextView
            android:id="@+id/TextView10"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Remarks."
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintBottom_toTopOf="@+id/bt_usa_box_add_items"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/et_usa_box_remarks"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TextView10"
            app:layout_constraintTop_toTopOf="@+id/TextView10"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <Button
            android:id="@+id/bt_usa_box_clear"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginLeft="24dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/btn_custom1"
            android:text="CLEAR"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bt_usa_box_add_items" />

        <Button
            android:id="@+id/bt_usa_box_add_items"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/btn_custom1"
            android:text="Add / Edit"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/bt_usa_box_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/btn_custom1"
            android:text="BUILD"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bt_usa_box_clear" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>