<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tv_aging_stock_taking_delete_itemdetails"
        android:layout_width="160dp"
        android:layout_height="33dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left|center"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_aging_stock_taking_delete_srid"
        android:layout_width="0dp"
        android:layout_height="33dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left|center"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_aging_stock_taking_delete"
        app:layout_constraintStart_toEndOf="@+id/tv_aging_stock_taking_delete_itemdetails"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_aging_stock_taking_delete"
        android:layout_width="50dp"
        android:layout_height="30dp"
        android:background="@drawable/btn_custom1"
        android:text="Delete"
        android:textAllCaps="false"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_aging_stock_taking_delete_itemdetails"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_aging_stock_taking_delete_itemdetails" />


</androidx.constraintlayout.widget.ConstraintLayout>