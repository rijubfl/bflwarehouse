<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    tools:context=".ui.Updateboxfrompallet.AddOrRemoveBoxInPalletFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_add_remove"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Add / Remove"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/et_box_no"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/et_custom"
            android:focusable="true"
            android:hint=""
            android:padding="8dp"
            android:singleLine="true"
            android:text=""
            android:textSize="14dp"
            app:layout_constraintEnd_toStartOf="@id/btn_scan_box"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/tv_box"
            app:layout_constraintTop_toTopOf="@+id/tv_box" />

        <Button
            android:id="@+id/btn_scan_box"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_custom1"
            android:text="SCAN"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_box_no"
            tools:ignore="TouchTargetSizeCheck" />

        <RadioGroup
            android:id="@+id/rg_add_remove"
            android:layout_width="0dp"
            android:layout_height="40dp"

            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:layout_centerInParent="true"
            app:layout_constraintLeft_toRightOf="@id/tv_add_remove"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_add_remove"
            app:layout_constraintTop_toTopOf="parent">

            <RadioButton
                android:id="@+id/rb_add"
                android:layout_width="0dp"
                android:checked="true"
                android:layout_weight="1"
                android:background="@drawable/et_custom_total"
                android:layout_marginRight="5dp"
                android:layout_height="match_parent"
                android:text="Add" />


            <RadioButton
                android:id="@+id/rb_remove"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:background="@drawable/et_custom_total"
                android:layout_weight="1"
                android:text="Remove" />


        </RadioGroup>

        <!--        <RadioButton-->
        <!--            android:id="@+id/rb_add"-->
        <!--            android:layout_width="130dp"-->
        <!--            android:layout_height="40dp"-->
        <!--            android:layout_marginStart="5dp"-->
        <!--            android:background="@drawable/et_custom_total"-->
        <!--            android:gravity="center"-->
        <!--            android:hint=""-->
        <!--            android:padding="8dp"-->
        <!--            android:textSize="14dp"-->
        <!--            android:text="Add"-->
        <!--            app:layout_constraintLeft_toRightOf="@id/tv_add_remove"-->
        <!--            app:layout_constraintTop_toTopOf="parent"/>-->
