<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent">

   <!-- <TextView
        android:id="@+id/tv_grn_transfer_ticket_description"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text="Description"
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_grn_transfer_ticket_itemcode" />-->

    <TextView
        android:id="@+id/tv_grn_transfer_ticket_itemcode"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text="Itemcode"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_grn_transfer_ticket_scanqty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_grn_transfer_ticket_scanqty"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:padding="5dp"
        android:text="0"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_grn_transfer_ticket_trfqty"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_grn_transfer_ticket_trfqty"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:padding="5dp"
        android:text="0"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_grn_transfer_ticket_diffqty"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_grn_transfer_ticket_diffqty"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text="0"
        android:gravity="right"
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>