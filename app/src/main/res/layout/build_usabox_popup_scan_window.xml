<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="380dp"
    android:padding="5dp"
    android:background="@color/colorBackPopup"
    android:layout_gravity="center"
    android:layout_height="650dp">

    <EditText
        android:id="@+id/et_build_usabox_popup_itemcode"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:hint="Itemcode / Upc"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/et_build_usabox_popup_qty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_build_usabox_popup_qty"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:gravity="right"
        android:hint="Qty"
        android:inputType="number"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_build_usabox_popup_scan"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text="Total"
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/bt_build_usabox_popup_ok"
        app:layout_constraintEnd_toStartOf="@+id/tv_build_usabox_popup_total"
        app:layout_constraintStart_toStartOf="parent" />


    <Button
        android:id="@+id/bt_build_usabox_popup_scan"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:background="@drawable/btn_custom1"
        android:text="ADD"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/et_build_usabox_popup_itemcode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_build_usabox_popup_itemcode" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:padding="5dp"
        android:text="Itemcode"
        android:textColor="@color/coloBlack"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/textView3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_build_usabox_popup_division" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:gravity="center"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text="Qty"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/textView5"
        app:layout_constraintTop_toTopOf="@+id/textView1" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text=""
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView1" />

    <ListView
        android:id="@+id/lv_build_usabox_popup_scandetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/et_custom_total"
        app:layout_constraintBottom_toTopOf="@+id/textView11"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView1" />

    <TextView
        android:id="@+id/tv_build_usabox_popup_last_scan"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/et_custom_total"
        android:hint="Last Scan"
        android:padding="8dp"
        android:textAlignment="center"
        android:textColor="@color/coloBlack"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_build_usabox_popup_itemcode" />

    <TextView
        android:id="@+id/tv_build_usabox_popup_building_category"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/et_custom_total"
        android:hint="Building Category"
        android:padding="8dp"
        android:textAlignment="center"
        android:textColor="@color/coloRed"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_build_usabox_popup_last_scan" />

    <TextView
        android:id="@+id/tv_build_usabox_popup_division"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/et_custom_total"
        android:hint="Division"
        android:padding="8dp"
        android:textAlignment="center"
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_build_usabox_popup_building_category" />

    <TextView
        android:id="@+id/tv_build_usabox_popup_total"
        android:layout_width="80dp"
        android:layout_height="35dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:padding="5dp"
        android:text="0"
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        app:layout_constraintEnd_toStartOf="@+id/textView15"
        app:layout_constraintTop_toTopOf="@+id/textView11" />

    <TextView
        android:id="@+id/textView15"
        android:layout_width="80dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text=""
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView11" />

    <Button
        android:id="@+id/bt_build_usabox_popup_ok"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:background="@drawable/btn_custom1"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>