<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="350dp"
    android:padding="5dp"
    android:background="@color/colorBackPopup"
    android:layout_gravity="center"
    app:layout_constraintTop_toTopOf="parent"
    android:layout_height="280dp">

    <EditText
        android:id="@+id/et_popup_itemcode"
        android:layout_width="0dp"
        android:inputType="text"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/et_custom"
        android:hint="Itemcode / Upc"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.437"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

<!--    <Button-->
<!--        android:id="@+id/bt_scan_itemcode"-->
<!--        android:layout_width="70dp"-->
<!--        android:layout_height="40dp"-->
<!--        android:background="@drawable/btn_custom1"-->
<!--        android:text="SCAN"-->
<!--        android:textAllCaps="false"-->
<!--        android:textSize="14sp"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent" />-->

    <TextView
        android:id="@+id/textView5"
        android:layout_width="0dp"
        android:layout_height="30dp"

        android:layout_marginLeft="2dp"
        android:layout_marginTop="10dp"
        android:padding="3dp"
        android:text="Select one of the below option:"
        android:textAlignment="center"
        android:textColor="@color/coloBlack"
        android:textSize="16sp"
        android:textStyle="bold"

        app:layout_constraintHorizontal_bias="0.8"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/et_popup_itemcode" />
    <Button
        android:id="@+id/tv_good"
        android:layout_width="110dp"
        android:layout_height="60dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="5dp"
        android:background="@color/colorGreen"
        android:padding="10dp"
        android:text="Good"
        android:focusable="false"
        android:textAlignment="center"
        android:textColor="@color/coloBlack"
        android:textSize="15sp"
        android:textStyle="bold"
        android:drawableLeft="@android:drawable/ic_input_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <Button
        android:id="@+id/tv_asis"
        android:layout_width="90dp"
        android:layout_height="60dp"
        android:padding="10dp"
        android:text="As Is"
        android:focusable="false"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:background="@color/colorYellow"
        android:textColor="@color/coloBlack"
        android:textAlignment="center"
        android:textSize="15sp"
        android:drawableLeft="@android:drawable/ic_dialog_info"
        app:layout_constraintStart_toEndOf="@+id/tv_good"
        app:layout_constraintTop_toBottomOf="@+id/textView5"
        android:textStyle="bold"
        />
    <Button
        android:id="@+id/tv_writeoff"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:focusable="false"
        android:background="@drawable/btn_custom2"
        android:padding="10dp"
        android:text="write off"
        android:layout_marginTop="5dp"
        android:textColor="@color/coloBlack"
        android:layout_marginLeft="10dp"
        android:textAlignment="center"
        android:textSize="15sp"
        android:drawableLeft="@android:drawable/ic_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_asis"
        app:layout_constraintTop_toBottomOf="@+id/textView5"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/tv_remarks"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="5dp"
        android:padding="10dp"
        android:text=""
        android:textAlignment="center"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_writeoff" />

    <Button
        android:id="@+id/bt_build_popup_ok"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/btn_custom1"
        android:text="OK"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>