<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="350dp"
    android:padding="5dp"
    android:background="@color/colorBackPopup"
    android:layout_gravity="center"
    android:layout_height="600dp">

    <TextView
        android:id="@+id/textView1"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text="Itemcode"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/textView3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_grn_transfer_popup_itemcode" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="75dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text="Qty"
        android:textSize="15dp"
        app:layout_constraintEnd_toStartOf="@+id/textView5"
        app:layout_constraintTop_toBottomOf="@+id/et_grn_transfer_popup_itemcode" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="50dp"
        android:layout_height="31dp"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text=""
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView1" />

    <TextView
        android:id="@+id/tv_grn_transfer_popup_transfer_number"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@drawable/et_custom_total"
        android:padding="5dp"
        android:text=""
        android:textSize="20dp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_grn_transfer_popup_itemcode"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:ems="10"
        android:hint="Itemcode"
        android:padding="15dp"
        app:layout_constraintEnd_toStartOf="@+id/et_grn_transfer_popup_qty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_grn_transfer_popup_transfer_number" />

    <ListView
        android:id="@+id/li_grn_transfer_popup_details"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/et_custom_total"
        app:layout_constraintBottom_toTopOf="@+id/bt_grn_transfer_popup_ok"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView1" />

    <EditText
        android:id="@+id/et_grn_transfer_popup_qty"
        android:layout_width="60dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:inputType="number"
        android:ems="10"
        android:hint="Qty"
        android:padding="15dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_grn_transfer_popup_scan"
        app:layout_constraintTop_toBottomOf="@+id/tv_grn_transfer_popup_transfer_number" />

    <Button
        android:id="@+id/bt_grn_transfer_popup_scan"
        android:layout_width="75dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/btn_custom1"
        android:text="SCAN"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_grn_transfer_popup_transfer_number" />

    <Button
        android:id="@+id/bt_grn_transfer_popup_ok"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_custom1"
        android:text="OK"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
