<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tv_upc"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        />




    <TextView
        android:id="@+id/tv_generate_barcode"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:layout_marginLeft="0dp"
        android:background="@drawable/et_custom_total"
        android:text=""
        android:textColor="@color/coloBlack"
        android:gravity="center"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/tv_upc"
        app:layout_constraintTop_toTopOf="@+id/tv_upc"

        />
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="90dp"
        android:layout_height="30dp"
        android:layout_marginLeft="0dp"
        android:background="@drawable/et_custom_total"
        android:text=""
        android:textColor="@color/coloBlack"
        android:gravity="center"
        android:textSize="14sp"

        app:layout_constraintStart_toEndOf="@+id/tv_generate_barcode"
        app:layout_constraintTop_toTopOf="@+id/tv_upc"

        />
    <Button
        android:id="@+id/tv_delete"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginLeft="0dp"
        android:background="@drawable/btn_custom1"
        android:text="DELETE"
        android:textColor="@color/coloBlack"
        android:gravity="center"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_status"
        app:layout_constraintTop_toTopOf="@+id/tv_upc"

        />






</androidx.constraintlayout.widget.ConstraintLayout>