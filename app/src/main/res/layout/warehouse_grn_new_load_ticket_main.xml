<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tv_ticket_wh_grn_new_palletno"
        android:layout_width="150dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_ticket_wh_grn_new_tcount"
        android:layout_width="90dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="16dp"
        app:layout_constraintStart_toEndOf="@+id/tv_ticket_wh_grn_new_palletno"
        app:layout_constraintTop_toTopOf="@+id/tv_ticket_wh_grn_new_palletno" />

    <TextView
        android:id="@+id/tv_ticket_wh_grn_new_scount"
        android:layout_width="90dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="right"
        android:hint=""
        android:padding="8dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="16dp"
        app:layout_constraintStart_toEndOf="@+id/tv_ticket_wh_grn_new_tcount"
        app:layout_constraintTop_toTopOf="@+id/tv_ticket_wh_grn_new_palletno" />

    <Button
        android:id="@+id/bt_ticket_wh_grn_view"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginLeft="5dp"
        android:layout_weight="1"
        android:background="@color/colorBtn"
        android:text="View"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ticket_wh_grn_new_palletno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/tv_ticket_wh_grn_new_scount"
        app:layout_constraintTop_toTopOf="@+id/tv_ticket_wh_grn_new_palletno" />


</androidx.constraintlayout.widget.ConstraintLayout>