<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    tools:context=".ui.warehousegrn.WarehouseGRNFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="6dp">

        <Spinner
            android:id="@+id/sp_wh_grn_country"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="8dp"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/bt_wh_grn_scan_gin"
            app:layout_constraintStart_toEndOf="@+id/textView20"
            app:layout_constraintTop_toTopOf="@+id/textView20" />

        <TextView
            android:id="@+id/textView20"
            android:layout_width="105dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="GIN Location"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/TextView1"
            android:layout_width="105dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="GIN No."
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView20" />

        <EditText
            android:id="@+id/et_wh_grn_ginno"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_marginLeft   ="5dp"
            android:background="@drawable/et_custom"
            android:padding="10dp"
            android:inputType="number"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/tv_wh_grn_gindate"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/TextView1"
            app:layout_constraintTop_toTopOf="@+id/TextView1"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/et_wh_grn_warehouse_from"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom"
            android:padding="10dp"
            android:hint="WH. From"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView1"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/et_wh_grn_warehouse_to"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:padding="10dp"
            android:hint="WH. To"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/bt_wh_grn_scan_item"
            app:layout_constraintStart_toEndOf="@+id/et_wh_grn_warehouse_from"
            app:layout_constraintTop_toTopOf="@+id/et_wh_grn_warehouse_from"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/tv_wh_grn_gindate"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/bt_wh_grn_scan_gin"
            app:layout_constraintTop_toTopOf="@+id/TextView1"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <Button
            android:id="@+id/bt_wh_grn_scan_gin"
            android:layout_width="80dp"
            android:layout_height="0dp"
            android:background="@drawable/btn_custom1"
            android:text="FETCH"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/textView20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView20"
            tools:ignore="TouchTargetSizeCheck" />

        <Button
            android:id="@+id/bt_wh_grn_scan_item"
            android:layout_width="80dp"
            android:layout_height="0dp"
            android:background="@drawable/btn_custom1"
            android:text="Scan / Edit"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/et_wh_grn_warehouse_from"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView1"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/TextView3"
            android:layout_width="150dp"
            android:layout_height="35dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="8dp"
            android:text="Pallet No."
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_wh_grn_warehouse_from" />

        <TextView
            android:id="@+id/TextView7"
            android:layout_width="90dp"
            android:layout_height="35dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="8dp"
            android:text="Total.Box"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/TextView3"
            app:layout_constraintTop_toTopOf="@+id/TextView3" />

        <TextView
            android:id="@+id/TextView6"
            android:layout_width="90dp"
            android:layout_height="35dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="8dp"
            android:text="Scan.Box"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/TextView7"
            app:layout_constraintTop_toTopOf="@+id/TextView3" />

        <TextView
            android:id="@+id/TextView9"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="8dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TextView6"
            app:layout_constraintTop_toTopOf="@+id/TextView3" />

        <ListView
            android:id="@+id/lv_wh_grn_details"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/et_custom_total"
            app:layout_constraintBottom_toTopOf="@+id/TextView10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView3"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/TextView10"
            android:layout_width="150dp"
            android:layout_height="35dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="8dp"
            android:text="Total"
            android:textColor="@color/coloBlack"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/TextView11"
            app:layout_constraintStart_toStartOf="parent" />


        <TextView
            android:id="@+id/tv_wh_grn_total_plt_box_count"
            android:layout_width="90dp"
            android:layout_height="35dp"
            android:background="@drawable/et_custom_total"
            android:gravity="right"
            android:hint=""
            android:padding="8dp"
            android:text="0"
            android:textColor="@color/coloBlack"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/TextView10"
            app:layout_constraintTop_toTopOf="@+id/TextView10" />

        <TextView
            android:id="@+id/tv_wh_grn_total_plt_box_scan_count"
            android:layout_width="90dp"
            android:layout_height="35dp"
            android:background="@drawable/et_custom_total"
            android:gravity="right"
            android:hint=""
            android:padding="8dp"
            android:text="0"
            android:textColor="@color/coloBlack"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/tv_wh_grn_total_plt_box_count"
            app:layout_constraintTop_toTopOf="@+id/TextView10" />

        <TextView
            android:id="@+id/TextView17"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="8dp"
            android:text=""
            android:textColor="@color/coloBlack"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TextView6"
            app:layout_constraintTop_toTopOf="@+id/TextView10" />


        <TextView
            android:id="@+id/TextView11"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Total Pallets"
            android:textColor="@color/coloBlack"
            android:textSize="16dp"
            app:layout_constraintBottom_toTopOf="@+id/bt_wh_grn_clear"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_wh_grn_total_plt_count"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/et_custom"
            android:gravity="right"
            android:hint=""
            android:padding="10dp"
            android:text="0"
            android:textColor="@color/coloBlack"
            android:textSize="16dp"
            app:layout_constraintStart_toEndOf="@+id/TextView11"
            app:layout_constraintTop_toTopOf="@+id/TextView11" />

        <TextView
            android:id="@+id/TextView12"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint=""
            android:padding="10dp"
            android:text="Scan Pallets"
            android:textColor="@color/coloBlack"
            android:textSize="16dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_wh_grn_scan_plt_count"
            app:layout_constraintTop_toTopOf="@+id/TextView11" />

        <TextView
            android:id="@+id/tv_wh_grn_scan_plt_count"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="right"
            android:hint=""
            android:padding="10dp"
            android:text="0"
            android:textColor="@color/coloBlack"
            android:textSize="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView11" />

        <Button
            android:id="@+id/bt_wh_grn_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/btn_custom1"
            android:text="CLEAR"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/textView2"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/bt_wh_grn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/btn_custom1"
            android:text="SAVE"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView2" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:text=""
            android:textColor="@color/colorAccent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="SpeakableTextPresentCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>