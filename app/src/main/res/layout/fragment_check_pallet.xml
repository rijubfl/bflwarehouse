<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    >
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    >

    <TextView
        android:id="@+id/TextView1"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:textColor="@color/coloBlack"
        android:hint=""
        android:padding="10dp"
        android:text="Warehouse"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_rack_in_out_warehouse"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="5dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:hint=""
        android:padding="10dp"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/TextView1"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/TextView2"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:hint=""
        android:padding="10dp"
        android:text="Rack No."
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TextView1" />

    <Spinner
        android:id="@+id/sp_racks"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="5dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="8dp"
        android:text="Last Saved Data"
        android:textSize="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/TextView2"
        app:layout_constraintTop_toBottomOf="@+id/tv_rack_in_out_warehouse" />

    <Button
        android:id="@+id/bt_show_pallets"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_custom1"
        android:text="Show"
        android:textAllCaps="false"

        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sp_racks" />

    <TextView
        android:id="@+id/PalletCount"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:background="@drawable/et_custom"
        android:gravity="left"
        android:textColor="@color/coloBlack"
        android:layout_marginTop="5dp"
        android:hint=""
        android:padding="10dp"
        android:text="Pallet Count"
        android:textSize="14dp"
        app:layout_constraintTop_toBottomOf="@id/bt_show_pallets"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/tv_pallet_count"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="5dp"
        android:textColor="@color/coloBlack"
        android:background="@drawable/et_custom"
        android:layout_marginTop="5dp"
        android:gravity="left"
        android:hint=""
        android:padding="10dp"
        android:textSize="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bt_show_pallets"
        app:layout_constraintStart_toEndOf="@+id/PalletCount"
        />


    <ListView
        android:id="@+id/lv_rack_in_out_details"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/et_custom_total"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_rowno"
        app:layout_constraintVertical_bias="0.0" >

<!--        <TextView-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="match_parent">-->

<!--        </TextView>-->
    </ListView>

    <TextView
        android:id="@+id/tv_rowno"
        android:layout_width="70dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:hint=""
        android:padding="6dp"
        android:text="Rack"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PalletCount"
         />

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:textStyle="bold"
        android:textAlignment="center"
        android:hint=""
        android:padding="6dp"
        android:text="Date"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/tv_palletno1"
        app:layout_constraintStart_toEndOf="@+id/tv_rowno"
        app:layout_constraintTop_toTopOf="@+id/tv_rowno"
        />

    <TextView
        android:id="@+id/tv_palletno1"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:textAlignment="center"
        android:hint=""
        android:textStyle="bold"
        android:padding="6dp"
        android:text="Pallet no 1"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/tv_date"
        app:layout_constraintTop_toTopOf="@+id/tv_rowno" />

    <TextView
        android:id="@+id/tv_palletno2"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:textAlignment="center"
        android:hint=""
        android:textStyle="bold"
        android:padding="6dp"
        android:text="Pallet no 2"
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_palletno1"
        app:layout_constraintTop_toTopOf="@+id/tv_rowno" />




</androidx.constraintlayout.widget.ConstraintLayout>



</FrameLayout>