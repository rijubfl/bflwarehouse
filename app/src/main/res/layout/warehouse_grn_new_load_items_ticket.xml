<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tv_ticket_wh_grn_new_scan_palletno"
        android:layout_width="120dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:padding="5dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_ticket_wh_grn_new_scan_boxno"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:padding="5dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="16dp"
        app:layout_constraintStart_toEndOf="@+id/tv_ticket_wh_grn_new_scan_palletno"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_ticket_wh_grn_new_scan_toteid"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:padding="5dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="16dp"
        app:layout_constraintStart_toEndOf="@+id/tv_ticket_wh_grn_new_scan_boxno"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_ticket_wh_grn_new_scan_delete"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginLeft="8dp"
        android:layout_weight="1"
        android:background="@color/colorBtn"
        android:text="Delete"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ticket_wh_grn_new_scan_palletno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/tv_ticket_wh_grn_new_scan_toteid"
        app:layout_constraintTop_toTopOf="@+id/tv_ticket_wh_grn_new_scan_palletno" />



</androidx.constraintlayout.widget.ConstraintLayout>