<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="370dp"
    android:padding="5dp"
    android:background="@color/colorBackPopup"
    android:layout_gravity="center"
    android:layout_height="61dp">

    <EditText
        android:id="@+id/et_ageing_stock_taking_popup_password"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/et_custom"
        android:hint="Password"
        android:inputType="textPassword"
        android:padding="10dp"
        android:textColor="@color/coloBlack"
        android:textSize="18dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_ageing_stock_taking_popup_password_ok"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_ageing_stock_taking_popup_password_ok"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/btn_custom1"
        android:text="OK"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@+id/bt_ageing_stock_taking_popup_password_close"
        app:layout_constraintHorizontal_bias="0.687"
        app:layout_constraintTop_toTopOf="@+id/et_ageing_stock_taking_popup_password" />

    <Button
        android:id="@+id/bt_ageing_stock_taking_popup_password_close"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/btn_custom1"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_ageing_stock_taking_popup_password" />


</androidx.constraintlayout.widget.ConstraintLayout>