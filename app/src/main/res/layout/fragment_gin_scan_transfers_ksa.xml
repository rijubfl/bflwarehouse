        <TextView
            android:id="@+id/TextView8"
            android:layout_width="120dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="6dp"
            android:text="Transfer No"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_shopnames_col" />

        <TextView
            android:id="@+id/TextView6"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:background="@drawable/et_custom_total"
            android:gravity="left"
            android:hint=""
            android:padding="6dp"
            android:text="Toteid"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView7"
            app:layout_constraintStart_toEndOf="@+id/TextView8"
            app:layout_constraintTop_toTopOf="@+id/TextView8" />

        <TextView
            android:id="@+id/TextView7"
            android:layout_width="120dp"
            android:layout_height="30dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="6dp"
            android:text="ShopName"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/TextView9"
            app:layout_constraintTop_toTopOf="@+id/TextView6" />

        <TextView
            android:id="@+id/TextView9"
            android:layout_width="70dp"
            android:layout_height="30dp"
            android:background="@drawable/et_custom_total"
            android:gravity="center"
            android:hint=""
            android:padding="6dp"
            android:text="Qty"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/TextView8" />

        <ListView
            android:id="@+id/lv_div_seperate_det"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/et_custom_total"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TextView8"
            app:layout_constraintBottom_toTopOf="@+id/et_remarks" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint="Count"
            android:padding="10dp"
            android:textColor="@color/coloBlack"
            android:textSize="12dp"
            app:layout_constraintBottom_toTopOf="@+id/et_date"
            app:layout_constraintEnd_toStartOf="@+id/et_driver"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/et_driver"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint="Driver name"
            android:padding="10dp"
            android:layout_marginRight="5dp"
            android:textColor="@color/coloBlack"
            android:textSize="12dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toTopOf="@+id/et_date"
            app:layout_constraintEnd_toStartOf="@+id/et_car_no"
            app:layout_constraintStart_toEndOf="@+id/tv_count"
            app:layout_constraintTop_toTopOf="@+id/tv_count" />

        <EditText
            android:id="@+id/et_car_no"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/et_custom"
            android:gravity="left"
            android:hint="car no"
            android:padding="10dp"
            android:layout_marginBottom="5dp"
            android:textColor="@color/coloBlack"
            android:textSize="12dp"
            app:layout_constraintEnd_toStartOf="@+id/et_Ship_no"
            app:layout_constraintStart_toEndOf="@+id/et_driver"
            app:layout_constraintTop_toTopOf="@+id/et_driver" />





        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:textColor="@color/colorAccent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"

            tools:ignore="SpeakableTextPresentCheck" />

        <EditText
            android:id="@+id/et_remarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@drawable/et_custom"
            android:hint="Remarks"
            android:padding="10dp"
            android:textAllCaps="false"
            android:textSize="12dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_count"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"

            />
        <EditText
            android:id="@+id/et_Ship_no"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:gravity="center"
            android:hint="Ship no"
            android:padding="10dp"
            android:textAlignment="center"
            android:textColor="@color/coloBlack"
            android:textSize="12dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_driver"
            app:layout_constraintBottom_toTopOf="@+id/et_date"
            />
        <TextView android:id="@+id/DelDate"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="Delivery Date"
            android:layout_marginBottom="5dp"
            android:layout_marginRight="10dp"
            android:layout_margin="0dp"
            app:layout_constraintTop_toBottomOf="@id/et_driver"
            app:layout_constraintBottom_toTopOf="@+id/et_way_slips"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="@color/coloBlack"
            android:textSize="14sp"
            android:padding="10dp"
            android:background="@drawable/et_custom"/>





        <EditText
            android:id="@+id/et_date"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:padding="2dp"
            android:textColor="@color/coloBlack"
            android:textSize="14dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintStart_toEndOf="@+id/DelDate"
            app:layout_constraintBottom_toTopOf="@+id/et_way_slips"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <EditText
            android:id="@+id/et_way_slips"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:hint="Enter way slips"
            android:textAllCaps="false"
            android:enabled="false"
            android:textSize="15sp"
            android:padding="2dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp"
            app:layout_constraintBottom_toTopOf="@+id/bt_status_clear"
            app:layout_constraintEnd_toStartOf="@+id/bt_status_clear"
            app:layout_constraintStart_toStartOf="parent" />

        <Spinner
            android:id="@+id/sp_vehicle_type"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:padding="2dp"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="5dp"
            android:textAllCaps="false"
            android:entries="@array/vehicleType"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toEndOf="@+id/et_way_slips"
            app:layout_constraintBottom_toTopOf="@+id/bt_status_clear"
            app:layout_constraintEnd_toStartOf="@+id/sp_vendor"

            />
        <Spinner
            android:id="@+id/sp_vendor"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/et_custom"
            android:padding="2dp"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="5dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toEndOf="@+id/sp_vehicle_type"
            app:layout_constraintBottom_toTopOf="@+id/bt_status_clear"
            app:layout_constraintEnd_toEndOf="parent"

            />

        <Button
            android:id="@+id/bt_clear_pallet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_custom1"
            android:text="Clear Pallet"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:padding="2dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bt_status_clear"
            app:layout_constraintStart_toStartOf="parent" />

      <Button
            android:id="@+id/bt_status_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_custom1"
            android:text="Clear ALL"
            android:padding="2dp"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="5dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toEndOf="@+id/bt_clear_pallet"
           app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/bt_status_build_Gin"

            />
        <Button
            android:id="@+id/bt_status_build_Gin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_custom1"
            android:text="BUILD GIN"
            android:padding="2dp"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="5dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toEndOf="@+id/bt_status_clear"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            />

