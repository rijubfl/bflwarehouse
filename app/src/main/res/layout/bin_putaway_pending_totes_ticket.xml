<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tv_bin_putaway_pending_ticket_batchid"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_bin_putaway_pending_ticket_toteid"
        android:layout_width="70dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="12dp"
        app:layout_constraintStart_toEndOf="@+id/tv_bin_putaway_pending_ticket_batchid"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_bin_putaway_pending_ticket_boxno"
        android:layout_width="70dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="12dp"
        app:layout_constraintStart_toEndOf="@+id/tv_bin_putaway_pending_ticket_toteid"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_bin_putaway_pending_ticket_time"
        android:layout_width="70dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="12dp"
        app:layout_constraintStart_toEndOf="@+id/tv_bin_putaway_pending_ticket_boxno"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_bin_putaway_pending_ticket_boxremarks"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_bin_putaway_pending_ticket_time"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>