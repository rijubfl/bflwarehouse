<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tv_gin_verification_ticket_ginno"
        android:layout_width="70dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_gin_verification_ticket_palletno"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/tv_gin_verification_ticket_ginno"
        app:layout_constraintTop_toTopOf="@+id/tv_gin_verification_ticket_ginno" />

    <TextView
        android:id="@+id/tv_gin_verification_ticket_toteid"
        android:layout_width="90dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/tv_gin_verification_ticket_palletno"
        app:layout_constraintTop_toTopOf="@+id/tv_gin_verification_ticket_ginno" />

    <TextView
        android:id="@+id/tv_gin_verification_ticket_trfno"
        android:layout_width="95dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="left"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloBlack"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/tv_gin_verification_ticket_toteid"
        app:layout_constraintTop_toTopOf="@+id/tv_gin_verification_ticket_ginno" />

    <TextView
        android:id="@+id/tv_gin_verification_ticket_status"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@drawable/et_custom_total"
        android:gravity="center"
        android:hint=""
        android:padding="6dp"
        android:text=""
        android:textColor="@color/coloRed"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_gin_verification_ticket_trfno"
        app:layout_constraintTop_toTopOf="@+id/tv_gin_verification_ticket_ginno" />

</androidx.constraintlayout.widget.ConstraintLayout>